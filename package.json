{
  "name": "hashturn-automation",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "audit": "tsx scripts/audit.ts",
    "test:browser": "tsx scripts/browser-check.ts",
    "test:integration": "node --env-file=.env --import tsx scripts/integration-check.ts",
    "format:check": "prettier --check app components lib scripts/*.ts next.config.ts proxy.ts neon.ts hello.ts",
    "cf:build": "node scripts/cloudflare-build.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.131.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
