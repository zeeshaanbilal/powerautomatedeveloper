DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hashturn?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/hashturn?schema=public"
SITE_URL="https://powerautomatedeveloper.com"
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Set only behind a trusted proxy that overwrites x-forwarded-for.
TRUST_PROXY="false"
# Persistent disk directory; mount this on your production server.
MEDIA_DIR="./public/uploads"
# Neon object storage (populated automatically by neon env pull).
MEDIA_BUCKET="uploads"
AWS_ENDPOINT_URL_S3=""
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Enable canonical host and HTTPS redirects only on the production deployment.
ENFORCE_CANONICAL="false"
